generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSGRES_PRISMA_URL")
  directUrl = env("POSGRES_URL_NON_POOLING")
}

model expenses {
  id                 String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id            String?              @db.Uuid
  amount             Decimal              @db.Decimal(10, 2)
  category_id        String?              @db.Uuid
  subcategory_id     String?              @db.Uuid
  description        String?
  date               DateTime             @db.Date
  created_at         DateTime?            @default(now()) @db.Timestamp(6)
  emotion_id         Int?
  satisfaction       Int?
  currencyId         Int?
  original_amount    Decimal?             @db.Decimal(10, 2)
  exchange_rate      Decimal?             @db.Decimal(10, 6)
  expensecategory    expense_category?    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  emotion            emotion?             @relation(fields: [emotion_id], references: [id], onUpdate: NoAction)
  expensesubcategory expense_subcategory? @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "expenses_sub_category_fkey")
  users              users?               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency           currency?            @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model users {
  id                     String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name                   String             @db.VarChar(255)
  email                  String             @unique
  password               String
  last_updated           DateTime           @default(now()) @db.Date
  created_at             DateTime?          @default(now()) @db.Timestamp(6)
  currency_id            Int?
  tour_finished          Boolean?           @default(false)
  fully_signed_up        Boolean?           @default(false)
  lang                   String?
  subscription_plan      String?
  subscription_id        String?
  subscription_cancel_at Int?               @default(0)
  stripeId               String?            @unique
  pricing_group          String?
  goal_amount            Decimal?           @db.Decimal(10, 2)
  goal_timeframe         String?            @db.VarChar(50)
  goal_description       String?
  last_advice_date       DateTime?          @db.Date
  earning                earning[]
  earning_category       earning_category[]
  expense_category       expense_category[]
  expenses               expenses[]
  savings                saving[]
  currency               currency?          @relation(fields: [currency_id], references: [id], onUpdate: NoAction)
  contacts               contacts[]
}

model expense_category {
  id                  String                @id(map: "usercategory_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String?               @db.Uuid
  name                String                @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  color               String?               @db.VarChar(7)
  users               users?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "usercategory_user_id_fkey")
  expense_subcategory expense_subcategory[]
  expenses            expenses[]
}

model expense_subcategory {
  id               String            @id(map: "usersubcategory_pkey") @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id          String?           @db.Uuid
  category_id      String?           @db.Uuid
  name             String            @db.VarChar(100)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  expense_category expense_category? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "usersubcategory_category_id_fkey")
  expenses         expenses[]
}

model earning {
  id                  String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String?              @db.Uuid
  amount              Decimal              @db.Decimal(10, 2)
  category_id         String?              @db.Uuid
  subcategory_id      String?              @db.Uuid
  description         String?
  date                DateTime             @db.Date
  created_at          DateTime?            @default(now()) @db.Timestamp(6)
  currencyId          Int?
  original_amount     Decimal?             @db.Decimal(10, 2)
  exchange_rate       Decimal?             @db.Decimal(10, 6)
  earning_category    earning_category?    @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  earning_subcategory earning_subcategory? @relation(fields: [subcategory_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users               users?               @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currency            currency?            @relation(fields: [currencyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model earning_category {
  id                  String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id             String?               @db.Uuid
  name                String                @db.VarChar(100)
  created_at          DateTime?             @default(now()) @db.Timestamp(6)
  color               String?               @db.VarChar(7)
  earning             earning[]
  users               users?                @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  earning_subcategory earning_subcategory[]
}

model earning_subcategory {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  category_id      String?           @db.Uuid
  name             String            @db.VarChar(100)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  earning          earning[]
  earning_category earning_category? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model emotion {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(50)
  description  String?
  emotion_type String     @db.VarChar(10)
  color        String?    @db.VarChar(7)
  expenses     expenses[]
}

model currency {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(50)
  symbol       String
  description  String?
  countryCode  String?    @db.VarChar(2)
  currencyCode String?    @db.VarChar(3)
  users        users[]
  expenses     expenses[]
  earnings     earning[]
}

model saving {
  id          String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  user_id     String?   @db.Uuid
  amount      Decimal   @db.Decimal(10, 2)
  description String?
  date        DateTime  @db.Date
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  users       users?    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model contacts {
  id         String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name       String   @db.VarChar(255)
  mobile     String?  @db.VarChar(20)
  email      String?  @db.VarChar(255)
  instagram  String?  @db.VarChar(255)
  telegram   String?  @db.VarChar(255)
  whatsapp   String?  @db.VarChar(255)
  latitude   Float // New field for latitude
  longitude  Float // New field for longitude
  created_at DateTime @default(now()) @db.Timestamp(6)
  user_id    String?  @db.Uuid
  users      users?   @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model mcp_oauth_token {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  token_hash     String    @unique @db.VarChar(64)
  token_type     String    @db.VarChar(24)
  user_id        String    @db.Uuid
  client_id      String
  scopes         String
  resource       String
  redirect_uri   String?
  code_challenge String?
  expires_at     DateTime  @db.Timestamp(6)
  used_at        DateTime? @db.Timestamp(6)
  revoked_at     DateTime? @db.Timestamp(6)
  created_at     DateTime  @default(now()) @db.Timestamp(6)

  @@index([token_hash, token_type])
  @@index([user_id, client_id])
}

model pricing_option {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String?  @db.VarChar(255)
  price          Float?
  most_popular   Boolean? @default(false)
  paymentLink    String?  @db.VarChar(255)
  period         String?  @db.VarChar(255)
  pricing_group  String?  @db.VarChar(255)
  is_discount    Boolean? @default(false)
  original_price Float?

  created_at DateTime? @default(now()) @db.Timestamp(6)
}
