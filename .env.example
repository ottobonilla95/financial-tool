# Copy to .env. Example values only; use a separate development database.
# POSGRES is the exact spelling used in prisma/schema.prisma.
# Local PostgreSQL: both URLs may be identical. Neon: pooled URL then direct URL.
POSGRES_PRISMA_URL="postgresql://postgres:postgres@localhost:5432/track_my_spend?schema=public"
POSGRES_URL_NON_POOLING="postgresql://postgres:postgres@localhost:5432/track_my_spend?schema=public"

# Generate your own: openssl rand -base64 32
AUTH_SECRET="replace-with-your-own-random-secret"
# The dashboard fetches its currency API at this origin.
NEXT_PUBLIC_APP_URL="http://localhost:3005"

# Optional MCP. Use your own origin, without a trailing slash.
MCP_PUBLIC_ORIGIN="http://localhost:3005"
MCP_TIMEZONE="UTC"
# These fall back to AUTH_SECRET when omitted.
# MCP_REVIEW_SECRET=""
# MCP_OAUTH_SECRET=""

# In-app import: the OpenAI client initializes at module load, even when
# unused or Z.ai is selected. This placeholder permits manual-only local use;
# replace it with your real key before using OpenAI imports.
OPENAI_API_KEY="unused-local-development-placeholder"
EXPENSE_IMPORT_PROVIDER="openai"
# Defaults mirror the implementation, not guaranteed provider availability.
# OPENAI_EXPENSE_IMPORT_MODEL="gpt-5.5"
# OPENAI_EXPENSE_IMPORT_REASONING_EFFORT="low"
# OPENAI_EXPENSE_IMPORT_MAX_OUTPUT_TOKENS="8000"
# OPENAI_EXPENSE_IMPORT_MAX_INPUT_CHARS="20000"
# OPENAI_EXPENSE_IMPORT_TIMEOUT_MS="55000"
# ZAI_API_KEY=""
# ZAI_BASE_URL="https://api.z.ai/api/paas/v4/"
# ZAI_EXPENSE_IMPORT_MODEL="glm-5.2"

# Resend initializes at module load in Hotmart routes.
# This placeholder permits initialization but cannot send real email.
RESEND_API_KEY="re_local_development_placeholder"

# Optional commerce integrations. Public signup still uses Systeme.io
# and payments; empty values do not enable payment-free registration.
# STRIPE_CHECKOUT_WEBHOOK_SECRET=""
# STRIPE_SUBSCRIPTION_WEBHOOK_SECRET=""
# STRIPE_CUSTOMER_PORTAL_URL=""
# HOTMART_CHECKOUT_URL_EN=""
# HOTMART_CHECKOUT_URL_ES=""
# SYSTEME_API_KEY=""
# SYSTEME_TRACKMYSPEND_TAG_ID=""
# SYSTEME_TRACKMYSPEND_PREMIUM_EN_TAG_ID=""
# SYSTEME_TRACKMYSPEND_PREMIUM_ES_TAG_ID=""
# SYSTEME_TRACKMYSPEND_NOT_SUBSCRIBED_ENGLISH_TAG_ID=""
# SYSTEME_TRACKMYSPEND_NOT_SUBSCRIBED_SPANISH_TAG_ID=""

# Optional Facebook integration. Other analytics scripts are hardcoded in
# app/[lang]/layout.tsx and are NOT disabled by omitting these values.
# NEXT_PUBLIC_FACEBOOK_PIXEL_ID=""
# NEXT_PUBLIC_FACEBOOK_ACCESS_TOKEN=""
# Review the existing NEXT_PUBLIC access-token name before public use.
# Exchange-rate credentials are currently hardcoded, not env-configured.
